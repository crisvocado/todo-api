# Identifies this service to logcore. A sink-delivered log without it is
# discarded, because a service name is not unique across customers.
LOGCORE_SERVICE_ID=ef17dff4-9b7c-4342-9932-c912562a2f3f

# One of: prod, staging, dev, test, local. Defaults to dev.
LOGCORE_ENV=dev

# GCP project the service runs in. Cloud Run does not set it by default;
# logcore reads it only to name the service in its discard warnings.
GOOGLE_CLOUD_PROJECT=seed-prod-b9508c89
