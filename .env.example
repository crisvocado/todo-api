# The platform's id for this service. Without it logcore discards every log the
# sink delivers, because a service NAME is not unique across customers.
LOGCORE_SERVICE_ID=792548c2-c128-460c-82ca-f26b9205b5cd

# One of: prod, staging, dev, test, local. Absent, every issue records env="unknown".
LOGCORE_ENV=dev

# GCP project the service runs in. Optional — logcore reads it only to name the
# service in its discard warning.
LOGCORE_SOURCE_PROJECT=
