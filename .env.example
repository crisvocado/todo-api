# logcore — structured logs go to stdout; Cloud Logging captures them and the
# sink forwards them. No API key is involved on this path.

# Required. logcore discards a sink-delivered log that declares no service_id,
# because a service NAME is not unique across customers. A re-created service
# is issued a new id, so this is set at deploy time and never hardcoded.
LOGCORE_SERVICE_ID=77dd2fa0-cf6e-48d7-9730-88fb4ed20a05

# One of: prod, staging, dev, test, local. Absent, every issue from this
# service records env="unknown".
LOGCORE_ENV=dev

# GCP project the service runs in. Defaults to GOOGLE_CLOUD_PROJECT, which
# Cloud Run sets on its own.
LOGCORE_SOURCE_PROJECT=seed-prod-b9508c89

# Optional; defaults to todo-api.
LOGCORE_SERVICE_NAME=todo-api
