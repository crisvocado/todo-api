# logcore — required. Without it logcore discards every log the sink delivers,
# because a service NAME is not unique across customers.
LOGCORE_SERVICE_ID=77dd2fa0-cf6e-48d7-9730-88fb4ed20a05

# Optional. Defaults: service todo-api, env dev. One of prod/staging/dev/test/local.
# LOGCORE_SERVICE=todo-api
# LOGCORE_ENV=dev
# LOGCORE_SOURCE_PROJECT=  # GCP project id; falls back to GOOGLE_CLOUD_PROJECT
