# Id que emite la plataforma para este servicio. Es el único campo sin el cual
# logcore descarta el log entregado por el sink: un NOMBRE de servicio no es
# único entre clientes. Se lee del entorno, no se hardcodea, porque un servicio
# recreado recibe un id nuevo.
LOGCORE_SERVICE_ID=92be1903-39cf-41eb-9046-3989ef7f5be2

# Uno de: prod, staging, dev, test, local.
LOGCORE_ENV=dev

# Proyecto GCP donde corre el servicio.
LOGCORE_SOURCE_PROJECT=seed-prod-b9508c89

# Nombre del servicio tal y como está registrado en la plataforma.
LOGCORE_SERVICE_NAME=todo-api
